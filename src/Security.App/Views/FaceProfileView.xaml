<UserControl x:Class="Security.App.Views.FaceProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">

            <!-- ==================== Header ==================== -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Face Profile" Style="{StaticResource Text.Title}" />
                <Border Style="{StaticResource Badge}" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProfileExists, Converter={StaticResource ProfileState}}"
                               Style="{StaticResource Text.Muted}" />
                </Border>
            </StackPanel>

            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,14" TextWrapping="Wrap"
                       Text="Enrollment captures a sequence of images of your face, converts each to an encrypted numeric template, then averages them into a single profile. Raw photos are not stored." />

            <!-- ==================== Step indicator ====================
                 Five chips; the current step is emphasised by a DataTrigger
                 (a Border cannot host DataTriggers directly). -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Step.Item}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWelcome}" Value="True">
                                    <Setter Property="Background" Value="#16283C" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="1   Welcome" FontSize="11" />
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Step.Item}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPosition}" Value="True">
                                    <Setter Property="Background" Value="#16283C" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="2   Position" FontSize="11" />
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Step.Item}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCapture}" Value="True">
                                    <Setter Property="Background" Value="#16283C" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter Property="Background" Value="#3A1216" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="3   Capture" FontSize="11" />
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Step.Item}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                    <Setter Property="Background" Value="#16283C" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="4   Processing" FontSize="11" />
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Step.Item}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                    <Setter Property="Background" Value="#0B2B22" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Success}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Success}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="5   Complete" FontSize="11" />
                </Border>
            </StackPanel>

            <!-- Not-ready banner -->
            <Border Background="#3B2E0A"
                    BorderBrush="{StaticResource Brush.Warning}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,14"
                    Visibility="{Binding EngineNotice, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding EngineNotice}"
                           Foreground="{StaticResource Brush.Warning}"
                           TextWrapping="Wrap"
                           FontSize="12" />
            </Border>

            <!-- Error -->
            <Border Background="#3A1216"
                    BorderBrush="{StaticResource Brush.Danger}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,14"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Brush.Danger}"
                           TextWrapping="Wrap"
                           FontSize="12" />
            </Border>

            <!-- ==================== Body ==================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!-- ============ Main card ============ -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Live preview (Position + Capture) -->
                        <Border Grid.Row="0"
                                Background="#05080C"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                Height="286"
                                Margin="0,0,0,16"
                                Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Viewbox Stretch="Uniform"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Grid Width="{Binding SurfaceWidth}" Height="{Binding SurfaceHeight}">
                                        <Image Source="{Binding Preview}"
                                               Stretch="Fill"
                                               RenderOptions.BitmapScalingMode="LowQuality" />
                                        <Canvas Width="{Binding SurfaceWidth}"
                                                Height="{Binding SurfaceHeight}"
                                                IsHitTestVisible="False">
                                            <ItemsControl ItemsSource="{Binding Boxes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="{Binding Width}"
                                                                Height="{Binding Height}"
                                                                Style="{StaticResource Overlay.Box}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                    </Grid>
                                </Viewbox>

                                <!-- Camera-off placeholder inside the preview area -->
                                <TextBlock Text="Camera is off"
                                           Style="{StaticResource Text.Muted}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasPreview, Converter={StaticResource InvertBoolToVisibility}}" />

                                <!-- Face count -->
                                <Border Style="{StaticResource Badge}"
                                        Background="#0B0F14E6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="4">
                                    <TextBlock Text="{Binding FaceCount, StringFormat={}Faces: {0}}"
                                               Style="{StaticResource Text.Mono}" />
                                </Border>

                                <!-- Quality / rejection message -->
                                <Border Background="#0B0F14E6"
                                        CornerRadius="6"
                                        Padding="9,6"
                                        Margin="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding QualityMessage, Converter={StaticResource StringToVisibility}}">
                                    <TextBlock Text="{Binding QualityMessage}"
                                               Style="{StaticResource Text.Mono}"
                                               Foreground="{StaticResource Brush.Warning}"
                                               TextWrapping="Wrap"
                                               MaxWidth="460" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 1. Welcome -->
                        <StackPanel Grid.Row="1"
                                    Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Heading}" />

                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="The wizard takes about a minute. It walks you through positioning, captures 20 samples, then encrypts and stores a single numeric template on this machine." />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#0D131B" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="WHAT IS STORED" Style="{StaticResource Text.Label}" />
                                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="One 128-value numeric template, encrypted with Windows DPAPI for the current user." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#0D131B" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="WHAT IS NOT STORED" Style="{StaticResource Text.Label}" />
                                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="No photographs or video frames. They are processed in memory and discarded." />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button Content="Continue"
                                        Command="{Binding NextCommand}"
                                        Style="{StaticResource Button.Primary}"
                                        MinWidth="140" />
                                <Button Content="Delete profile"
                                        Command="{Binding DeleteCommand}"
                                        Style="{StaticResource Button.Danger}"
                                        Margin="10,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="You can delete your profile at any time from this page."
                                       Style="{StaticResource Text.Muted}"
                                       Margin="0,14,0,0" />
                        </StackPanel>

                        <!-- 2. Position your face -->
                        <StackPanel Grid.Row="1"
                                    Visibility="{Binding IsPosition, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Position your face" Style="{StaticResource Text.Heading}" />

                            <TextBlock Text="{Binding PositionHint}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Accent}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />

                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Sit at eye level with even light in front of you. Keep exactly one face in the frame; the guide box turns solid when the detector is locked on." />

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Content="Start capture"
                                        Command="{Binding BeginCaptureCommand}"
                                        Style="{StaticResource Button.Primary}"
                                        MinWidth="150" />
                                <Button Content="Back"
                                        Command="{Binding BackCommand}"
                                        Style="{StaticResource Button.Secondary}"
                                        Margin="10,0,0,0" />
                                <Button Content="Cancel"
                                        Command="{Binding CancelCommand}"
                                        Style="{StaticResource Button.Ghost}"
                                        Margin="10,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="Capture starts only when exactly one face is detected."
                                       Style="{StaticResource Text.Muted}"
                                       Margin="0,14,0,0" />
                        </StackPanel>

                        <!-- 3. Capture samples -->
                        <StackPanel Grid.Row="1"
                                    Visibility="{Binding IsCapture, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Heading}" />
                                <TextBlock Text="{Binding SampleTargetText}"
                                           Style="{StaticResource Text.Muted}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>

                            <ProgressBar Style="{StaticResource Progress.Bar}"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding Percent, Mode=OneWay}"
                                         Margin="0,16,0,0" />

                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding CapturedLabel}" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="{Binding Percent, StringFormat={}{0:0}%}"
                                           Style="{StaticResource Text.Mono}"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource Brush.Accent}" />
                            </DockPanel>

                            <!-- Pose prompt + rejection detail -->
                            <Border Background="#0D131B"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="CURRENT INSTRUCTION" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding Instruction}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Accent}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding Detail}"
                                               Style="{StaticResource Text.Secondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="Cancel"
                                        Command="{Binding CancelCommand}"
                                        Style="{StaticResource Button.Secondary}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,12,0,0" TextWrapping="Wrap"
                                       Text="Samples are rejected when the face is missing, multiple faces are visible, the image is blurry, too dark, too bright, or the face is too small or off-centre. A short cooldown paces accepted samples so successive captures are not near-identical." />
                        </StackPanel>

                        <!-- 4. Processing -->
                        <StackPanel Grid.Row="1"
                                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Processing" Style="{StaticResource Text.Heading}" />

                            <TextBlock Text="{Binding Instruction}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Accent}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />

                            <TextBlock Text="{Binding Detail}"
                                       Style="{StaticResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />

                            <ProgressBar Style="{StaticResource Progress.Bar}"
                                         IsIndeterminate="True"
                                         Margin="0,20,0,0" />

                            <TextBlock Text="This usually takes a few seconds. Please wait."
                                       Style="{StaticResource Text.Muted}"
                                       Margin="0,14,0,0" />
                        </StackPanel>

                        <!-- 5. Complete -->
                        <StackPanel Grid.Row="1"
                                    Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10"
                                         Fill="{StaticResource Brush.Success}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Face profile created"
                                           Style="{StaticResource Text.Heading}"
                                           Margin="10,0,0,0" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="Your template is stored locally and encrypted. Recognition can now match a live face against it." />

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Profile name"
                                           Style="{StaticResource Text.Muted}" Margin="0,0,0,9" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CompletedProfileName}"
                                           Style="{StaticResource Text.Secondary}" Margin="0,0,0,9" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Created"
                                           Style="{StaticResource Text.Muted}" Margin="0,0,0,9" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CompletedDateText}"
                                           Style="{StaticResource Text.Secondary}" Margin="0,0,0,9" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Samples used"
                                           Style="{StaticResource Text.Muted}" Margin="0,0,0,9" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CompletedSamplesText}"
                                           Style="{StaticResource Text.Mono}" Margin="0,0,0,9" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Model version"
                                           Style="{StaticResource Text.Muted}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CompletedModelVersion}"
                                           Style="{StaticResource Text.Mono}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button Content="Done"
                                        Command="{Binding DoneCommand}"
                                        Style="{StaticResource Button.Primary}"
                                        MinWidth="140" />
                                <Button Content="Delete profile"
                                        Command="{Binding DeleteCommand}"
                                        Style="{StaticResource Button.Danger}"
                                        Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Validation failed -->
                        <StackPanel Grid.Row="1"
                                    Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10"
                                         Fill="{StaticResource Brush.Danger}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Validation failed"
                                           Style="{StaticResource Text.Heading}"
                                           Margin="10,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="{Binding FailureMessage}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Danger}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0" />

                            <Border Background="#0D131B"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="COMMON CAUSES" Style="{StaticResource Text.Label}" />
                                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,9,0,0" TextWrapping="Wrap"
                                               Text="&#8226; No samples captured — no face was clearly visible." />
                                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="&#8226; Multiple faces in frame — only one person may be visible." />
                                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="&#8226; Model unavailable — the ONNX models could not be loaded." />
                                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="&#8226; Invalid template — the generated embedding failed validation." />
                                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="&#8226; Database or encryption failure — the profile could not be saved." />
                                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="&#8226; Camera disconnected — reconnect it, or start it from the Camera screen." />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button Content="Retry"
                                        Command="{Binding RetryCommand}"
                                        Style="{StaticResource Button.Primary}"
                                        MinWidth="130" />
                                <Button Content="Cancel"
                                        Command="{Binding CancelCommand}"
                                        Style="{StaticResource Button.Secondary}"
                                        Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ Guidance card ============ -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="HOW IT WORKS" Style="{StaticResource Text.Label}" />
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,8" TextWrapping="Wrap">
                                <Run Text="1. " FontWeight="Bold" />
                                <Run Text="Hold the camera at eye level in even light." />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,8" TextWrapping="Wrap">
                                <Run Text="2. " FontWeight="Bold" />
                                <Run Text="Keep exactly one face in frame and follow the prompt." />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,8" TextWrapping="Wrap">
                                <Run Text="3. " FontWeight="Bold" />
                                <Run Text="Turn and tilt slightly between samples for better coverage." />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap">
                                <Run Text="4. " FontWeight="Bold" />
                                <Run Text="When the bar reaches 100% the profile is encrypted and saved." />
                            </TextBlock>
                        </StackPanel>

                        <Separator Style="{StaticResource Divider}" />

                        <TextBlock Text="PRIVACY" Style="{StaticResource Text.Label}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Only a 128-value numeric template is stored, encrypted with Windows DPAPI for the current user. Camera frames are never written to disk or logs." />

                        <Separator Style="{StaticResource Divider}" />

                        <TextBlock Text="SAMPLE STATUS" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding SampleTargetText}"
                                   Style="{StaticResource Text.Secondary}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding EngineStatusText}"
                                   Style="{StaticResource Text.Muted}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
