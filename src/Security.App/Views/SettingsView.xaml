<UserControl x:Class="Security.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Every row follows the same contract: Title | Control | Description.
      Column widths are shared so the eye can scan titles and controls as two
      clean vertical bands, and each description sits directly across from the
      control it explains.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Settings" Style="{StaticResource Text.Title}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Reset to defaults" Command="{Binding ResetCommand}" Style="{StaticResource Button.Ghost}" />
                    <Button Content="Save changes" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Feedback -->
            <Border Background="#3A1216"
                    BorderBrush="{StaticResource Brush.Danger}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,8,0,10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <TextBlock Text="{Binding SavedMessage}"
                       Style="{StaticResource Text.Secondary}"
                       Foreground="{StaticResource Brush.Success}"
                       Margin="0,0,0,10"
                       Visibility="{Binding SavedMessage, Converter={StaticResource StringToVisibility}}" />

            <!-- ==================== MONITORING (spec §6) ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="MONITORING" Style="{StaticResource Text.Label}" />

                    <CheckBox Content="Background monitoring"
                              IsChecked="{Binding BackgroundMonitoring}"
                              Margin="0,12,0,0"
                              Style="{StaticResource Input.CheckBox}" />
                    <TextBlock Text="Master switch for the background service: session observation, camera policy, event recording and retention. Turning it off stops monitoring until you turn it back on."
                               Style="{StaticResource Text.Muted}" Margin="27,4,0,0" TextWrapping="Wrap" />

                    <CheckBox Content="Monitor Windows session"
                              IsChecked="{Binding SessionMonitoring}"
                              Margin="0,12,0,0"
                              Style="{StaticResource Input.CheckBox}" />
                    <TextBlock Text="Record SessionLocked, SessionUnlocked, logon and logoff events using supported Windows APIs. Never reads credentials and never shows UI on the lock screen."
                               Style="{StaticResource Text.Muted}" Margin="27,4,0,0" TextWrapping="Wrap" />

                    <CheckBox Content="Monitor camera when unlocked"
                              IsChecked="{Binding MonitorCameraWhenUnlocked}"
                              Margin="0,12,0,0"
                              Style="{StaticResource Input.CheckBox}" />
                    <TextBlock Text="Run the camera while you are signed in and unlocked. It always stops when Windows locks — no frames are captured on the lock screen."
                               Style="{StaticResource Text.Muted}" Margin="27,4,0,0" TextWrapping="Wrap" />

                    <CheckBox Content="Unknown face detection"
                              IsChecked="{Binding UnknownFaceDetection}"
                              Margin="0,12,0,0"
                              Style="{StaticResource Input.CheckBox}" />
                    <TextBlock Text="Create an &quot;Unknown person detected&quot; event when a face does not match your enrolled profile. Events are rate-limited by a cooldown in Recognition."
                               Style="{StaticResource Text.Muted}" Margin="27,4,0,0" TextWrapping="Wrap" />

                    <CheckBox Content="Desktop notifications"
                              IsChecked="{Binding DesktopNotifications}"
                              Margin="0,12,0,0"
                              Style="{StaticResource Input.CheckBox}" />
                    <TextBlock Text="Show a tray balloon when an unknown person is detected. Notifications never appear on the lock screen or Secure Desktop."
                               Style="{StaticResource Text.Muted}" Margin="27,4,0,0" TextWrapping="Wrap" />

                    <Separator Style="{StaticResource Divider}" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Notification cooldown -->
                        <TextBlock Grid.Row="0" Text="Notification cooldown (s)" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Input.Text}"
                                 Text="{Binding NotificationCooldownSeconds, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding NotificationCooldownNote}"
                                   Style="{StaticResource Text.Muted}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <!-- Event retention -->
                        <TextBlock Grid.Row="1" Text="Keep events for (days)" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,13,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Input.Text}" Margin="0,13,0,0"
                                 Text="{Binding EventRetentionDays, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding EventRetentionNote}"
                                   Style="{StaticResource Text.Muted}" Margin="14,13,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <!-- Snapshot retention -->
                        <TextBlock Grid.Row="2" Text="Keep snapshots for (days)" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,13,0,0" />
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding SnapshotRetentionOptions}"
                                  SelectedItem="{Binding SnapshotRetentionDays, Mode=TwoWay}"
                                  Margin="0,13,0,0"
                                  Style="{StaticResource Input.ComboBox}"
                                  ItemContainerStyle="{StaticResource Input.ComboBox.Item}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SnapshotRetentionNote}"
                                   Style="{StaticResource Text.Muted}" Margin="14,13,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== CAMERA ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="CAMERA" Style="{StaticResource Text.Label}" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Capture resolution -->
                        <TextBlock Grid.Row="0" Text="Capture resolution" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding CameraResolutions}"
                                  SelectedItem="{Binding CameraResolution, Mode=TwoWay}"
                                  Style="{StaticResource Input.ComboBox}"
                                  ItemContainerStyle="{StaticResource Input.ComboBox.Item}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Text.Muted}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding CameraResolutionNote}" />

                        <!-- Detected devices -->
                        <TextBlock Grid.Row="1" Text="Detected devices" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,13,0,0" />
                        <Button Grid.Row="1" Grid.Column="1" Content="Refresh device list"
                                Command="{Binding RefreshCamerasCommand}"
                                Style="{StaticResource Button.Secondary}"
                                Margin="0,13,0,0"
                                HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Text.Muted}" Margin="14,13,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding DetectedDeviceText}" />

                        <!-- Capture device -->
                        <TextBlock Grid.Row="2" Text="Capture device" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,13,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDeviceText}"
                                   Style="{StaticResource Text.Mono}" VerticalAlignment="Center" Margin="0,13,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Text.Muted}" Margin="14,13,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="The device used for preview, enrollment and recognition. Change it on the Camera screen." />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== RECOGNITION ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="RECOGNITION" Style="{StaticResource Text.Label}" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Threshold -->
                        <TextBlock Grid.Row="0" Text="Similarity threshold" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Input.Text}"
                                 Text="{Binding Threshold, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ThresholdHint}"
                                   Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />

                        <!-- Minimum face size -->
                        <TextBlock Grid.Row="1" Text="Minimum face size (px)" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,13,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Input.Text}" Margin="0,13,0,0"
                                 Text="{Binding MinimumFaceSize, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Text.Muted}" Margin="14,13,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Faces smaller than this are ignored by recognition." />

                        <!-- Cooldown -->
                        <TextBlock Grid.Row="2" Text="Recognition cooldown (s)" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,13,0,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Input.Text}" Margin="0,13,0,0"
                                 Text="{Binding CooldownSeconds, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Text.Muted}" Margin="14,13,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Minimum gap between two recognition attempts. Default 5 seconds." />

                        <!-- Detection fps -->
                        <TextBlock Grid.Row="3" Text="Detection rate (FPS)" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,13,0,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Input.Text}" Margin="0,13,0,0"
                                 Text="{Binding DetectionFps, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Text.Muted}" Margin="14,13,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="How often frames are analysed. Recommended 5–10; higher values cost more CPU." />

                        <!-- Enrollment samples -->
                        <TextBlock Grid.Row="4" Text="Enrollment samples" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,13,0,0" />
                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Input.Text}" Margin="0,13,0,0"
                                 Text="{Binding EnrollmentSamples, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Text.Muted}" Margin="14,13,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Between 10 and 20. More samples generally improve robustness." />
                    </Grid>

                    <Separator Style="{StaticResource Divider}" />

                    <CheckBox Content="Enable face recognition"
                              IsChecked="{Binding RecognitionEnabled}"
                              Style="{StaticResource Input.CheckBox}" />
                    <TextBlock Text="Match live faces against the enrolled template and record a verdict."
                               Style="{StaticResource Text.Muted}" Margin="27,4,0,0" />

                    <CheckBox Content="Enable liveness check"
                              IsChecked="{Binding LivenessCheckEnabled}"
                              Margin="0,12,0,0"
                              Style="{StaticResource Input.CheckBox}" />
                    <TextBlock Text="{Binding LivenessNotice}"
                               Style="{StaticResource Text.Muted}"
                               Foreground="{StaticResource Brush.Warning}"
                               TextWrapping="Wrap"
                               Margin="27,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ==================== PRIVACY ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="PRIVACY" Style="{StaticResource Text.Label}" />

                    <CheckBox Content="Store security events"
                              IsChecked="{Binding StoreSecurityEvents}"
                              Margin="0,12,0,0"
                              Style="{StaticResource Input.CheckBox}" />
                    <TextBlock Text="Timestamps, event types and outcomes only. Never images, embeddings, or descriptors."
                               Style="{StaticResource Text.Muted}" Margin="27,4,0,0" TextWrapping="Wrap" />

                    <CheckBox Content="Store image snapshots"
                              IsChecked="{Binding StoreSnapshots}"
                              Margin="0,12,0,0"
                              Style="{StaticResource Input.CheckBox}" />
                    <TextBlock Text="OFF by default. When enabled, one frame is saved to the local data/events folder for each unknown-face event — never uploaded — and deleted automatically by the retention period below."
                               Style="{StaticResource Text.Muted}" Margin="27,4,0,0" TextWrapping="Wrap" />

                    <Separator Style="{StaticResource Divider}" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource Brush.Success}" />
                        <TextBlock Text="Everything stays on this device — no cloud calls, no external biometric APIs."
                                   Style="{StaticResource Text.Secondary}" Margin="9,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource Brush.Success}" />
                        <TextBlock Text="No passwords, PINs or Windows credentials are ever captured or stored."
                                   Style="{StaticResource Text.Secondary}" Margin="9,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource Brush.Success}" />
                        <TextBlock Text="Events, snapshots and retention are all local files you can delete at any time."
                                   Style="{StaticResource Text.Secondary}" Margin="9,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== APPLICATION ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="APPLICATION" Style="{StaticResource Text.Label}" />

                    <CheckBox Content="Start with Windows"
                              IsChecked="{Binding StartWithWindows}"
                              Margin="0,12,0,0"
                              Style="{StaticResource Input.CheckBox}" />
                    <TextBlock Text="Adds a per-user startup entry only. Windows sign-in is never modified."
                               Style="{StaticResource Text.Muted}" Margin="27,4,0,0" />

                    <CheckBox Content="Minimize to tray"
                              IsChecked="{Binding MinimizeToTray}"
                              IsEnabled="{Binding TrayAvailable}"
                              Margin="0,12,0,0"
                              Style="{StaticResource Input.CheckBox}" />
                    <TextBlock Text="ON by default: closing the window hides it to the notification area and monitoring continues. Use Exit on the tray menu to really quit. Turn this off to restore exit-on-close."
                               Style="{StaticResource Text.Muted}" Margin="27,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ==================== SECURITY ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="SECURITY" Style="{StaticResource Text.Label}" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Template encryption -->
                        <TextBlock Grid.Row="0" Text="Template encryption" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EncryptionLine}"
                                   Style="{StaticResource Text.Mono}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Text.Muted}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="The face template is encrypted before it is written, and can only be read back by your own Windows account." />

                        <!-- Credentials -->
                        <TextBlock Grid.Row="1" Text="Credentials stored" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,13,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CredentialLine}"
                                   Style="{StaticResource Text.Mono}" VerticalAlignment="Center" Margin="0,13,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Text.Muted}" Margin="14,13,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="No password, PIN, Windows credential, or key is ever captured, stored, or transmitted by this application." />

                        <!-- Network posture -->
                        <TextBlock Grid.Row="2" Text="Processing location" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,13,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StorageLine}"
                                   Style="{StaticResource Text.Mono}" VerticalAlignment="Center" Margin="0,13,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Text.Muted}" Margin="14,13,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Detection, matching and storage all happen on this machine. There are no cloud calls and no external biometric APIs." />

                        <!-- Event log -->
                        <TextBlock Grid.Row="3" Text="Security event log" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,13,0,0" />
                        <Button Grid.Row="3" Grid.Column="1" Content="Clear event log"
                                Command="{Binding ClearEventsCommand}"
                                IsEnabled="{Binding CanClearEvents}"
                                Style="{StaticResource Button.Danger}"
                                Margin="0,13,0,0"
                                HorizontalAlignment="Left"
                                ToolTip="Permanently remove all recorded security events" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Text.Muted}" Margin="14,13,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding EventCountText}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== ABOUT ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Open About"
                                Command="{Binding GoToAboutCommand}"
                                Style="{StaticResource Button.Ghost}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ABOUT" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding VersionLine}"
                                   Style="{StaticResource Text.Body}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="Local face security with background monitoring. Full capability list, privacy posture and limitations are on the About page."
                                   Style="{StaticResource Text.Muted}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,8" TextWrapping="Wrap">
                SECURITY.EXE does not replace Windows authentication and does not unlock, lock, or
                otherwise modify Windows. All processing, notifications and storage stay on this
                machine. Thresholds are starting defaults and must be calibrated against your own
                camera and model before any verdict should be relied upon.
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</UserControl>
