<UserControl x:Class="Security.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel MaxWidth="940" HorizontalAlignment="Left">

            <TextBlock Text="About" Style="{StaticResource Text.Title}" />

            <!-- Identity -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="54" Height="54" CornerRadius="12"
                            Background="{StaticResource Brush.NavActive}"
                            BorderBrush="{StaticResource Brush.Accent}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="26"
                                   Foreground="{StaticResource Brush.Accent}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.TextPrimary}" />
                        <TextBlock Text="{Binding Tagline}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding VersionLine}" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding RuntimeLine}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Technology stack -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="TECHNOLOGY STACK" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding TechStackLine}" Style="{StaticResource Text.Body}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Privacy statement -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="PRIVACY STATEMENT" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding PrivacyStatement}" Style="{StaticResource Text.Body}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Model -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="RECOGNITION MODEL" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding ModelLine}" Style="{StaticResource Text.Body}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding ThresholdNote}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding OpenCvLine}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Margin="0,0,7,14">
                    <StackPanel>
                        <TextBlock Text="SECURITY MODEL" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding SecurityPosture}" Style="{StaticResource Text.Body}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="7,0,0,14">
                    <StackPanel>
                        <TextBlock Text="PRIVACY MODEL" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding PrivacyPosture}" Style="{StaticResource Text.Body}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Background="{StaticResource Brush.SurfaceAlt}">
                <StackPanel>
                    <TextBlock Text="LIMITATIONS — READ BEFORE RELYING ON THIS BUILD" Style="{StaticResource Text.Label}"
                               Foreground="{StaticResource Brush.Warning}" />
                    <TextBlock Text="{Binding Limitations}" Style="{StaticResource Text.Body}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding LivenessPosture}" Style="{StaticResource Text.Secondary}"
                               Foreground="{StaticResource Brush.Warning}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="PHASE STATUS" Style="{StaticResource Text.Label}" />
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,10,0,0" TextWrapping="Wrap">
                        <Run Text="Phase 2 does not unlock Windows. " FontWeight="Bold" Foreground="{StaticResource Brush.Warning}" />
                        <Run Text="This release adds a reliable camera lifecycle (start / stop / restart), " />
                        <Run Text="a five-step enrollment wizard, live frame-quality guidance, a real per-sample " />
                        <Run Text="cooldown, recognition with a configurable threshold and cooldown, and a " />
                        <Run Text="styled control system across every page. " />
                        <Run Text="Real liveness detection, multiple profiles, and tray behaviour remain planned." />
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
