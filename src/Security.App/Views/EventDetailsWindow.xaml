<Window x:Class="Security.App.Views.EventDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event details"
        Width="640"
        Height="720"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="22,18,22,22">

            <TextBlock Text="Event details" Style="{StaticResource Text.Title}" />

            <!-- Identity fields -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Time" Style="{StaticResource Text.Label}" VerticalAlignment="Top" Margin="0,2,0,8" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                        <TextBlock Text="{Binding LocalTime}" Style="{StaticResource Text.Mono}" />
                        <TextBlock Text="{Binding UtcTime}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Event" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EventType}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Result" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Result}"
                               Foreground="{Binding Result, Converter={StaticResource EventResultToBrush}}"
                               Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Confidence" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Confidence, Converter={StaticResource Confidence}}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Session" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SessionState, Converter={StaticResource SessionState}}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Description" Style="{StaticResource Text.Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Description}"
                               Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- Snapshot -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Snapshot" Style="{StaticResource Text.Label}" />

                    <TextBlock Text="No snapshot stored."
                               Style="{StaticResource Text.Secondary}"
                               Margin="0,10,0,0"
                               Visibility="{Binding HasSnapshot, Converter={StaticResource InvertBoolToVisibility}}" />

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="{StaticResource Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6">
                            <Image Source="{Binding SnapshotImage}"
                                   MaxHeight="320"
                                   Stretch="Uniform"
                                   StretchDirection="DownOnly"
                                   HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding SnapshotPath}"
                                   Style="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Set when a snapshot is recorded but the file itself is gone. -->
                    <TextBlock Text="{Binding SnapshotError}"
                               Foreground="{StaticResource Brush.Warning}"
                               Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding SnapshotError, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Border>

            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    MinWidth="96"
                    IsCancel="True"
                    Style="{StaticResource Button.Primary}" />
        </StackPanel>
    </ScrollViewer>
</Window>
