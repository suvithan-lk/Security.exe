<UserControl x:Class="Security.App.Views.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Preview ==================== -->
        <Border Grid.Column="0"
                Style="{StaticResource Card}"
                Padding="10"
                Background="#05080C">
            <Grid>

                <!-- Aspect-ratio-correct preview: the Viewbox scales the
                     16:9 surface uniformly, so the image is never stretched. -->
                <Viewbox Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Grid Width="{Binding SurfaceWidth}" Height="{Binding SurfaceHeight}">

                        <Image Source="{Binding Preview}"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="LowQuality" />

                        <Canvas Width="{Binding SurfaceWidth}"
                                Height="{Binding SurfaceHeight}"
                                IsHitTestVisible="False">

                            <ItemsControl ItemsSource="{Binding Boxes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                Style="{StaticResource Overlay.Box}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Grid>
                </Viewbox>

                <!-- Status indicators (top-left) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="6">

                    <Border Style="{StaticResource StatusBadge.Live}"
                            Background="#0B2B22E6"
                            Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusBadge.Dot}"
                                     Fill="{StaticResource Brush.Success}" />
                            <TextBlock Text="LIVE"
                                       Style="{StaticResource StatusBadge.Caption}"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatusBadge.Connecting}"
                            Background="#3B2E0AE6"
                            Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusBadge.Dot}"
                                     Fill="{StaticResource Brush.Warning}" />
                            <TextBlock Text="CONNECTING"
                                       Style="{StaticResource StatusBadge.Caption}"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatusBadge.Offline}"
                            Background="#161E29E6"
                            Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusBadge.Dot}"
                                     Fill="{StaticResource Brush.TextMuted}" />
                            <TextBlock Text="OFFLINE"
                                       Style="{StaticResource StatusBadge.Caption}"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatusBadge.Error}"
                            Background="#3A1216E6"
                            Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusBadge.Dot}"
                                     Fill="{StaticResource Brush.Danger}" />
                            <TextBlock Text="ERROR"
                                       Style="{StaticResource StatusBadge.Caption}"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Badge}"
                            Background="#0B0F14E6"
                            Margin="8,0,0,0"
                            Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding FaceCount, StringFormat={}Faces: {0}}"
                                   Style="{StaticResource Text.Mono}" />
                    </Border>
                </StackPanel>

                <!-- Live status line (top-right) -->
                <Border Style="{StaticResource Badge}"
                        Background="#0B0F14E6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="6"
                        Visibility="{Binding StatusText, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource Text.Mono}"
                               Foreground="{StaticResource Brush.Accent}" />
                </Border>

                <!-- Quality / rejection message -->
                <Border Background="#0B0F14E6"
                        CornerRadius="6"
                        Padding="10,7"
                        Margin="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Visibility="{Binding QualityMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding QualityMessage}"
                               Style="{StaticResource Text.Mono}"
                               Foreground="{StaticResource Brush.Warning}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- ==================== CAMERA OFFLINE ====================
                     Stopped with no failure: an actionable empty state rather
                     than a silent black rectangle. -->
                <Border Background="#05080CF7"
                        Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE722;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="44"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="CAMERA OFFLINE"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="Start the camera to begin monitoring."
                                   Style="{StaticResource Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                        <Button Content="Start camera"
                                Command="{Binding StartCommand}"
                                Style="{StaticResource Button.Primary}"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0"
                                MinWidth="150" />
                    </StackPanel>
                </Border>

                <!-- ==================== CONNECTING ==================== -->
                <Border Background="#05080CF7"
                        Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE722;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="44"
                                   Foreground="{StaticResource Brush.Warning}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="CONNECTING…"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="Waiting for the first frame from the selected camera."
                                   Style="{StaticResource Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- ==================== CAMERA UNAVAILABLE ====================
                     Failure state: the reason, the concrete things to check,
                     and a Retry — never a silent stop. -->
                <Border Background="#05080CF7"
                        Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="460">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="44"
                                   Foreground="{StaticResource Brush.Danger}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="CAMERA UNAVAILABLE"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <ItemsControl ItemsSource="{Binding FailureReasons}"
                                      Margin="0,16,0,0"
                                      Visibility="{Binding HasFailureReasons, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{StaticResource Brush.Danger}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}"
                                                   Style="{StaticResource Text.Secondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="9,0,0,0"
                                                   MaxWidth="420" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0">
                            <Button Content="Retry"
                                    Command="{Binding RestartCommand}"
                                    Style="{StaticResource Button.Primary}"
                                    MinWidth="120" />
                            <Button Content="Refresh cameras"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== Controls ==================== -->
        <StackPanel Grid.Column="2" VerticalAlignment="Top">

            <!-- Engine warning -->
            <Border Background="#3B2E0A"
                    BorderBrush="{StaticResource Brush.Warning}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12"
                    Visibility="{Binding EngineNotice, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding EngineNotice}"
                           Foreground="{StaticResource Brush.Warning}"
                           TextWrapping="Wrap"
                           FontSize="12" />
            </Border>

            <!-- Non-camera error (model/profile issues) -->
            <Border Background="#3A1216"
                    BorderBrush="{StaticResource Brush.Danger}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Brush.Danger}"
                           TextWrapping="Wrap"
                           FontSize="12" />
            </Border>

            <!-- ============ STATUS ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="CAMERA STATUS" Style="{StaticResource Text.Label}" />

                    <!-- Status indicator -->
                    <Border Style="{StaticResource StatusBadge.Live}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusBadge.Dot}"
                                     Fill="{StaticResource Brush.Success}" />
                            <TextBlock Text="LIVE"
                                       Style="{StaticResource StatusBadge.Caption}"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatusBadge.Connecting}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusBadge.Dot}"
                                     Fill="{StaticResource Brush.Warning}" />
                            <TextBlock Text="CONNECTING"
                                       Style="{StaticResource StatusBadge.Caption}"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatusBadge.Offline}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusBadge.Dot}"
                                     Fill="{StaticResource Brush.TextMuted}" />
                            <TextBlock Text="OFFLINE"
                                       Style="{StaticResource StatusBadge.Caption}"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatusBadge.Error}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusBadge.Dot}"
                                     Fill="{StaticResource Brush.Danger}" />
                            <TextBlock Text="ERROR"
                                       Style="{StaticResource StatusBadge.Caption}"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Status block: Status / Resolution / FPS / Face detection -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Status"
                                   Style="{StaticResource Text.Muted}" Margin="0,0,0,7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CameraStatus}"
                                   Style="{StaticResource Text.Secondary}" Margin="0,0,0,7" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Resolution"
                                   Style="{StaticResource Text.Muted}" Margin="0,0,0,7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResolutionText}"
                                   Style="{StaticResource Text.Mono}" Margin="0,0,0,7" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="FPS"
                                   Style="{StaticResource Text.Muted}" Margin="0,0,0,7" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FpsText}"
                                   Style="{StaticResource Text.Mono}" Margin="0,0,0,7" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Face detection"
                                   Style="{StaticResource Text.Muted}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetectionText}"
                                   Style="{StaticResource Text.Secondary}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ DEVICE / CONTROLS ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="CAMERA DEVICE" Style="{StaticResource Text.Label}" />

                    <ComboBox ItemsSource="{Binding Cameras}"
                              SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                              Style="{StaticResource Input.ComboBox}"
                              ItemContainerStyle="{StaticResource Input.ComboBox.Item}"
                              Margin="0,10,0,0"
                              HorizontalContentAlignment="Left"
                              ToolTip="Capture device to use" />

                    <TextBlock Text="No camera detected. Connect one and choose Refresh."
                               Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding NoCameras, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource Button.Ghost}" />
                    </StackPanel>

                    <Separator Style="{StaticResource Divider}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Start camera"
                                Command="{Binding StartCommand}"
                                Style="{StaticResource Button.Primary}" />
                        <Button Content="Stop"
                                Command="{Binding StopCommand}"
                                Margin="8,0,0,0"
                                Style="{StaticResource Button.Secondary}" />
                    </StackPanel>

                    <Button Content="Restart camera"
                            Command="{Binding RestartCommand}"
                            Style="{StaticResource Button.Ghost}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Recognition verdict -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="RECOGNITION VERDICT" Style="{StaticResource Text.Label}" />

                    <TextBlock Text="{Binding VerdictText}"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,10,0,0"
                               Foreground="{Binding Recognition, Converter={StaticResource VerdictBrush}}" />

                    <!-- Confidence is called out as its own figure: it is the
                         number an operator ranks alerts by. -->
                    <DockPanel Margin="0,9,0,0">
                        <TextBlock Text="Confidence" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding ConfidenceText}"
                                   Style="{StaticResource Text.Mono}"
                                   FontSize="13"
                                   Foreground="{Binding Recognition, Converter={StaticResource VerdictBrush}}"
                                   HorizontalAlignment="Right" />
                    </DockPanel>

                    <TextBlock Text="{Binding VerdictDetail}"
                               Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <Separator Style="{StaticResource Divider}" />

                    <TextBlock Text="RECOGNITION READINESS" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding EngineStatus}"
                               Style="{StaticResource Text.Secondary}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Hints -->
            <Border Style="{StaticResource Card}" Background="{StaticResource Brush.SurfaceAlt}">
                <StackPanel>
                    <TextBlock Text="TIPS" Style="{StaticResource Text.Label}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap">
                        Face detection runs at a throttled rate — recognition runs only on a stable,
                        single, adequately sized face and respects the cooldown between verdicts.
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,10,0,0" TextWrapping="Wrap">
                        Multiple faces suppress recognition entirely.
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
