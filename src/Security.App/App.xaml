<Application x:Class="Security.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Security.App.ViewModels"
             xmlns:views="clr-namespace:Security.App.Views"
             xmlns:converters="clr-namespace:Security.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <converters:ToneToBrushConverter x:Key="ToneToBrush" />
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:StringNotEmptyToVisibilityConverter x:Key="StringToVisibility" />
            <converters:StringNotEmptyToVisibilityConverter x:Key="EmptyToVisibility" Invert="True" />
            <converters:UtcToLocalConverter x:Key="UtcToLocal" />
            <converters:ConfidenceConverter x:Key="Confidence" />
            <converters:EventResultToBrushConverter x:Key="EventResultToBrush" />
            <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
            <converters:BoolToTextConverter x:Key="ProfileState"
                                            TrueText="ENROLLED"
                                            FalseText="NOT ENROLLED" />
            <converters:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibility" />
            <converters:BoolToBrushConverter x:Key="BoolToBrush" />
            <converters:VerdictToBrushConverter x:Key="VerdictBrush" />
            <converters:BoolToTextConverter x:Key="RunningState"
                                            TrueText="RUNNING"
                                            FalseText="STOPPED" />

            <!-- Shared event row: time · type · result · confidence · description -->
            <DataTemplate x:Key="Template.EventRow">
                <Grid Margin="0,7" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Timestamp, Converter={StaticResource UtcToLocal}, ConverterParameter=HH:mm:ss}"
                               Style="{StaticResource Text.Mono}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding EventType}"
                               Style="{StaticResource Text.Body}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Result}"
                               Foreground="{Binding Result, Converter={StaticResource EventResultToBrush}}"
                               Style="{StaticResource Text.Body}" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding Confidence, Converter={StaticResource Confidence}}"
                               Style="{StaticResource Text.Mono}"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding Description}"
                               Style="{StaticResource Text.Secondary}"
                               TextTrimming="CharacterEllipsis"
                               Margin="10,0,0,0" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="Template.EventHeader">
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TIME" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="1" Text="EVENT" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="2" Text="RESULT" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="3" Text="CONF." Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="4" Text="DESCRIPTION" Style="{StaticResource Text.Label}" Margin="10,0,0,0" />
                </Grid>
            </DataTemplate>

            <!-- View <-> ViewModel mappings (shell switches CurrentViewModel). -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FaceProfileViewModel}">
                <views:FaceProfileView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CameraViewModel}">
                <views:CameraView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EventsViewModel}">
                <views:EventsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
